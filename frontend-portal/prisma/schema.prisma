datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Merchant {
  id                String             @id @default(uuid()) @db.Uuid
  businessName      String             @map("business_name") @db.VarChar(255)
  email             String             @unique @db.VarChar(255)
  status            String             @default("ACTIVE") @db.VarChar(50)
  webhookUrl        String?            @map("webhook_url") @db.VarChar(500)
  webhookSecret     String?            @map("webhook_secret") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiKeys           ApiKey[]
  customers         Customer[]
  paymentIntents    PaymentIntent[]
  ledgerAccounts    LedgerAccount[]
  webhookDeliveries WebhookDelivery[]

  @@map("merchants")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  keyPrefix   String    @map("key_prefix") @db.VarChar(32)
  secretHash  String    @map("secret_hash") @db.VarChar(64)
  keyType     String    @map("key_type") @db.VarChar(20)
  environment String    @default("TEST") @db.VarChar(20)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Customer {
  id             String          @id @default(uuid()) @db.Uuid
  merchantId     String          @map("merchant_id") @db.Uuid
  email          String          @db.VarChar(255)
  name           String?         @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentMethods PaymentMethod[]
  paymentIntents PaymentIntent[]

  @@map("customers")
}

model PaymentMethod {
  id             String          @id @default(uuid()) @db.Uuid
  customerId     String?         @map("customer_id") @db.Uuid
  type           String          @db.VarChar(50)
  tokenVaultId   String          @map("token_vault_id") @db.VarChar(255)
  last4          String          @db.VarChar(4)
  cardBrand      String?         @map("card_brand") @db.VarChar(50)
  expMonth       Int?            @map("exp_month")
  expYear        Int?            @map("exp_year")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentIntents PaymentIntent[]
  charges        Charge[]

  @@map("payment_methods")
}

model PaymentIntent {
  id                   String         @id @default(uuid()) @db.Uuid
  merchantId           String         @map("merchant_id") @db.Uuid
  customerId           String?        @map("customer_id") @db.Uuid
  paymentMethodId      String?        @map("payment_method_id") @db.Uuid
  amount               BigInt
  currency             String         @default("VND") @db.VarChar(3)
  status               String         @db.VarChar(50)
  clientSecret         String         @unique @map("client_secret") @db.VarChar(255)
  description          String?        @db.VarChar(500)
  idempotencyKey       String?        @unique @map("idempotency_key") @db.VarChar(255)
  metadata             Json?
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant             Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer             Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod        PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  charges              Charge[]

  @@map("payment_intents")
}

model Charge {
  id                   String         @id @default(uuid()) @db.Uuid
  paymentIntentId      String         @map("payment_intent_id") @db.Uuid
  paymentMethodId      String?        @map("payment_method_id") @db.Uuid
  amount               BigInt
  currency             String         @default("VND") @db.VarChar(3)
  status               String         @db.VarChar(50)
  gatewayReference     String?        @map("gateway_reference") @db.VarChar(255)
  failureCode          String?        @map("failure_code") @db.VarChar(100)
  failureMessage       String?        @map("failure_message") @db.VarChar(500)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentIntent        PaymentIntent  @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  ledgerEntries        LedgerEntry[]

  @@map("charges")
}

model LedgerAccount {
  id             String          @id @default(uuid()) @db.Uuid
  merchantId     String?         @map("merchant_id") @db.Uuid
  accountCode    String          @unique @map("account_code") @db.VarChar(100)
  accountName    String          @map("account_name") @db.VarChar(255)
  accountType    String          @map("account_type") @db.VarChar(50)
  currency       String          @default("VND") @db.VarChar(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant       Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  debitEntries   LedgerEntry[]   @relation("DebitAccount")
  creditEntries  LedgerEntry[]   @relation("CreditAccount")

  @@map("ledger_accounts")
}

model LedgerEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  chargeId           String?        @map("charge_id") @db.Uuid
  debitAccountId     String         @map("debit_account_id") @db.Uuid
  creditAccountId    String         @map("credit_account_id") @db.Uuid
  amount             BigInt
  currency           String         @default("VND") @db.VarChar(3)
  description        String?        @db.VarChar(500)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  charge             Charge?        @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  debitAccount       LedgerAccount  @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount      LedgerAccount  @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@map("ledger_entries")
}

model OutboxEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  aggregateType      String             @map("aggregate_type") @db.VarChar(100)
  aggregateId        String             @map("aggregate_id") @db.Uuid
  eventType          String             @map("event_type") @db.VarChar(100)
  payload            Json
  status             String             @default("PENDING") @db.VarChar(50)
  retryCount         Int?               @default(0) @map("retry_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  webhookDeliveries  WebhookDelivery[]

  @@map("outbox_events")
}

model WebhookDelivery {
  id              String       @id @default(uuid()) @db.Uuid
  merchantId      String       @map("merchant_id") @db.Uuid
  eventId         String       @map("event_id") @db.Uuid
  endpointUrl     String       @map("endpoint_url") @db.VarChar(500)
  requestHeaders  Json?        @map("request_headers")
  requestPayload  Json?        @map("request_payload")
  responseStatus  Int?         @map("response_status")
  responseBody    String?      @map("response_body")
  durationMs      Int?         @map("duration_ms")
  attempt         Int          @default(1)
  status          String       @db.VarChar(50)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant        Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  outboxEvent     OutboxEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}
